```css
/* 世勳旅行社 - 專業旅行社網站樣式 */

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family:
        "Noto Sans TC",
        "Microsoft JhengHei",
        sans-serif;

    color: #333;
    line-height: 1.8;
    background: #ffffff;
}


a {
    text-decoration: none;
    color: inherit;
}



/* ===== Header ===== */

header {

    display: flex;
    justify-content: space-between;
    align-items: center;

    padding: 20px 8%;

    background: #0b2d4d;

    color: white;

}


.logo h1 {

    font-size: 28px;

    letter-spacing: 3px;

}


.logo p {

    font-size: 12px;

    letter-spacing: 2px;

    opacity: 0.8;

}



nav a {

    margin-left: 25px;

    color: white;

    font-size: 16px;

}


nav a:hover {

    color: #d9b36c;

}



/* ===== Banner ===== */

.banner {

    height: 520px;

    background-image:

    linear-gradient(
        rgba(0,0,0,0.35),
        rgba(0,0,0,0.35)
    ),

    url("../images/banner.jpg");


    background-size: cover;

    background-position: center;

    display: flex;

    align-items: center;

    padding-left: 10%;

    color:white;

}



.banner-text {

    max-width: 550px;

}


.banner h2 {

    font-size: 48px;

    line-height: 1.4;

    margin-bottom:20px;

}


.banner p {

    font-size:18px;

    margin-bottom:30px;

}



.button {

    display:inline-block;

    padding:12px 30px;

    background:#c99a4b;

    color:white;

    border-radius:5px;

    transition:0.3s;

}


.button:hover {

    background:#a8782e;

}



/* ===== Sections ===== */

section {

    padding:70px 8%;

}



section h2 {

    text-align:center;

    font-size:32px;

    color:#0b2d4d;

    margin-bottom:40px;

}



/* ===== 行程卡片 ===== */


.cards {

    display:flex;

    gap:30px;

    justify-content:center;

}


.card {

    width:32%;

    background:white;

    border-radius:10px;

    overflow:hidden;

    box-shadow:
    0 5px 20px rgba(0,0,0,0.1);

}



.card img {

    width:100%;

    height:220px;

    object-fit:cover;

}



.card h3 {

    padding:20px 20px 10px;

    color:#0b2d4d;

}



.card p {

    padding:0 20px 20px;

}


.card a {

    display:block;

    margin:0 20px 25px;

    color:#c08b3d;

}



/* ===== 最新消息 ===== */


.news {

    background:#f5f7f9;

}



.news ul {

    max-width:700px;

    margin:auto;

    list-style:none;

}



.news li {

    padding:15px;

    border-bottom:1px solid #ddd;

}



/* ===== 公司特色 ===== */


.features {

    display:flex;

    justify-content:center;

    gap:40px;

}


.features div {

    text-align:center;

    width:30%;

}



.features h3 {

    color:#c08b3d;

    margin-bottom:15px;

}



/* ===== 聯絡區 ===== */


.contact-box {

    text-align:center;

    background:#0b2d4d;

    color:white;

}



.contact-box h2 {

    color:white;

}



.contact-box p {

    margin:10px;

}



/* ===== Footer ===== */


footer {

    text-align:center;

    padding:20px;

    background:#061c30;

    color:white;

}





/* ===== 手機版 ===== */


@media(max-width:768px){


header {

    flex-direction:column;

}


nav {

    margin-top:20px;

}


nav a {

    margin:0 10px;

}


.banner {

    height:400px;

    padding:30px;

}



.banner h2 {

    font-size:34px;

}



.cards {

    flex-direction:column;

}


.card {

    width:100%;

}



.features {

    flex-direction:column;

}


.features div {

    width:100%;

}


}
```
