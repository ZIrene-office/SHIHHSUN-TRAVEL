```css
/* =================================
   世勳旅行社 SHIH HSUN TRAVEL
   Professional Travel Website CSS
================================= */


/* 基本設定 */

* {

    margin: 0;

    padding: 0;

    box-sizing: border-box;

}


body {

    font-family:
    "Noto Sans TC",
    "Microsoft JhengHei",
    Arial,
    sans-serif;

    color:#333;

    line-height:1.8;

    background:#fff;

}



a {

    text-decoration:none;

    color:inherit;

}



img {

    max-width:100%;

    display:block;

}





/* =========================
   Header 導覽列
========================= */


header {

    display:flex;

    justify-content:space-between;

    align-items:center;

    padding:20px 8%;

    background:#0b2d4d;

    color:white;

}



.logo h1 {

    font-size:28px;

    letter-spacing:3px;

}



.logo p {

    font-size:12px;

    letter-spacing:2px;

    opacity:.8;

}



nav a {

    margin-left:25px;

    color:white;

    font-size:16px;

    transition:.3s;

}



nav a:hover {

    color:#d9b36c;

}





/* =========================
   首頁 Banner
========================= */


.banner {


    height:520px;


    background:


    linear-gradient(

    rgba(0,0,0,.35),

    rgba(0,0,0,.35)

    ),


    url("../images/banner.jpg");



    background-size:cover;


    background-position:center;



    display:flex;


    align-items:center;


    padding-left:10%;


    color:white;


}




.banner-text {


    max-width:550px;


}



.banner h2 {


    font-size:48px;


    line-height:1.4;


    margin-bottom:20px;


}



.banner p {


    font-size:18px;


    margin-bottom:30px;


}







/* =========================
   內頁 Banner
   出團情報
========================= */


.tour-banner {


    height:300px;


    background:


    linear-gradient(

    rgba(0,0,0,.45),

    rgba(0,0,0,.45)

    ),


    url("../images/tour-banner.jpg");



    background-size:cover;


    background-position:center;



    display:flex;


    flex-direction:column;


    justify-content:center;


    align-items:center;



    color:white;


    text-align:center;


}



.tour-banner h2 {


    font-size:42px;


    margin-bottom:10px;


}







/* =========================
   按鈕
========================= */


.button {


    display:inline-block;


    padding:12px 30px;


    background:#c99a4b;


    color:white;


    border-radius:5px;


    transition:.3s;


}



.button:hover {


    background:#a8782e;


}







/* =========================
   區塊設定
========================= */


section {


    padding:70px 8%;


}



section h2 {


    text-align:center;


    font-size:32px;


    color:#0b2d4d;


    margin-bottom:40px;


}







/* =========================
   行程卡片
========================= */


.cards {


    display:flex;


    gap:30px;


    justify-content:center;


    flex-wrap:wrap;


}



.card {


    width:31%;


    min-width:280px;


    background:white;


    border-radius:10px;


    overflow:hidden;



    box-shadow:


    0 5px 20px rgba(0,0,0,.12);



    transition:.3s;


}



.card:hover {


    transform:translateY(-5px);


}




.card img {


    width:100%;


    height:220px;


    object-fit:cover;


}



.card h3 {


    padding:20px 20px 10px;


    color:#0b2d4d;


    font-size:21px;


}



.card p {


    padding:0 20px 20px;


}



.card a {


    display:block;


    margin:0 20px 25px;


    color:#c08b3d;


    font-weight:bold;


}







/* =========================
   最新消息
========================= */


.news {


    background:#f5f7f9;


}



.news ul {


    max-width:700px;


    margin:auto;


    list-style:none;


}



.news li {


    padding:15px;


    border-bottom:1px solid #ddd;


}







/* =========================
   公司特色
========================= */


.features {


    display:flex;


    justify-content:center;


    gap:40px;


}



.features div {


    width:30%;


    text-align:center;


}



.features h3 {


    color:#c08b3d;


    margin-bottom:15px;


}







/* =========================
   聯絡區
========================= */


.contact-box {


    background:#0b2d4d;


    color:white;


    text-align:center;


}



.contact-box h2 {


    color:white;


}



.contact-box p {


    margin:10px;


}







/* =========================
   Footer
========================= */


footer {


    background:#061c30;


    color:white;


    text-align:center;


    padding:20px;


}







/* =========================
   手機版 RWD
========================= */


@media(max-width:768px){



header {


    flex-direction:column;


}



nav {


    margin-top:15px;


}



nav a {


    margin:0 8px;


    font-size:14px;


}




.banner {


    height:420px;


    padding:30px;


}




.banner h2 {


    font-size:34px;


}



.tour-banner h2 {


    font-size:32px;


}




.cards {


    flex-direction:column;


}



.card {


    width:100%;


}




.features {


    flex-direction:column;


}



.features div {


    width:100%;


}


}
```
